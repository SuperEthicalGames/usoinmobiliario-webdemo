# Copia este archivo a ".env" y llena los valores reales. ".env" nunca se sube al repo
# (ver .gitignore) — las credenciales privadas jamás viven en el código ni en el repositorio.

# --- Firebase Admin SDK ---
# Descarga el JSON de la cuenta de servicio en:
# Firebase Console > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada
# Pega aquí el contenido completo del JSON como una sola línea (o usa FIREBASE_SERVICE_ACCOUNT_PATH
# para apuntar a un archivo local en vez de pegar el JSON en el .env).
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_DATABASE_URL=https://usoinmobiliario-c8e83-default-rtdb.firebaseio.com

# --- WhatsApp Cloud API (Meta for Developers > tu app > WhatsApp > API Setup) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Cadena que tú inventas y pegas también en la configuración del Webhook en Meta — solo sirve
# para que Meta demuestre, al activar el webhook, que conoce este secreto (verificación GET).
WHATSAPP_VERIFY_TOKEN=

# --- Proveedor de IA: 'gemini' (gratis, cuota limitada) u 'openai' (de pago). ---
LLM_PROVIDER=gemini

# --- Gemini (Google AI Studio — https://aistudio.google.com/apikey, tiene cuota gratuita) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- OpenAI (platform.openai.com > API keys + Billing — de pago, SEPARADO de cualquier
# suscripción de ChatGPT como Plus/Pro/Go, esas son solo para chat.openai.com) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Servidor ---
PORT=3000
