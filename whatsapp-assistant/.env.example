# Copia este archivo a ".env" y llena los valores reales. ".env" nunca se sube al repo
# (ver .gitignore) — las credenciales privadas jamás viven en el código ni en el repositorio.

# --- Firebase Admin SDK ---
# Descarga el JSON de la cuenta de servicio en:
# Firebase Console > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada
# Pega aquí el contenido completo del JSON como una sola línea (o usa FIREBASE_SERVICE_ACCOUNT_PATH
# para apuntar a un archivo local en vez de pegar el JSON en el .env).
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_DATABASE_URL=https://usoinmobiliario-c8e83-default-rtdb.firebaseio.com

# --- WhatsApp Cloud API (Meta for Developers > tu app > WhatsApp > API Setup) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Cadena que tú inventas y pegas también en la configuración del Webhook en Meta — solo sirve
# para que Meta demuestre, al activar el webhook, que conoce este secreto (verificación GET).
WHATSAPP_VERIFY_TOKEN=
# "App Secret" de Meta for Developers > tu app > Configuración > Básica (un TERCER valor,
# distinto de WHATSAPP_TOKEN y WHATSAPP_VERIFY_TOKEN) — firma cada webhook entrante (HMAC-
# SHA256) para confirmar que de verdad viene de Meta y no de cualquiera que adivine la URL.
# OBLIGATORIO en producción: con NODE_ENV=production, el servidor RECHAZA todo el tráfico del
# webhook si esto falta (fail closed) — ver src/whatsapp.js. Fuera de producción, si falta,
# solo se advierte en logs y se acepta sin firma (para poder probar el bot en local sin tener
# que exponer un túnel público a Meta).
WHATSAPP_APP_SECRET=

# --- Proveedor de IA: 'gemini' (gratis, cuota limitada) u 'openai' (de pago). ---
LLM_PROVIDER=gemini

# --- Gemini (Google AI Studio — https://aistudio.google.com/apikey, tiene cuota gratuita) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- OpenAI (platform.openai.com > API keys + Billing — de pago, SEPARADO de cualquier
# suscripción de ChatGPT como Plus/Pro/Go, esas son solo para chat.openai.com) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Sitio web (para el link real de cada apartamento que manda el bot) ---
SITE_BASE_URL=https://superethicalgames.github.io/usoinmobiliario-webdemo

# --- Correo transaccional, $0 (SMTP de Gmail con la cuenta real del negocio) ---
# GMAIL_APP_PASSWORD NO es la contraseña normal de la cuenta — hay que activar verificación en
# dos pasos en https://myaccount.google.com/security y generar una "contraseña de aplicación"
# ahí mismo. Sin esto configurado, el correo de confirmación falla de forma controlada (la
# reserva se crea igual, el correo simplemente no se manda).
GMAIL_USER=usoinmobiliario@gmail.com
GMAIL_APP_PASSWORD=

# --- Servidor ---
PORT=3000
# 'production' activa controles que solo deben aplicar en el despliegue real (hoy: exigir
# WHATSAPP_APP_SECRET arriba). Déjalo vacío/'development' en local. render.yaml ya lo fija en
# 'production' para el despliegue real — no hace falta tocarlo ahí.
NODE_ENV=development
